# LifeTrack Pro — Next.js Environment Variables Template
# Copy this file to .env.local and populate with your environment values

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Supabase Credentials (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ACCESS_TOKEN=your-supabase-management-token

# --- Admin Authentication & Session Management (Server-Only) ---
ADMIN_EMAIL=admin@lifetrackpro.in
# Optional comma-separated list of additional allowed Google accounts for admin access:
# ADMIN_ALLOWED_EMAILS=admin1@gmail.com,admin2@company.com
ADMIN_PASSWORD_SALT=your-random-hex-salt-32-chars
ADMIN_PASSWORD_HASH=your-scrypt-hash-64-bytes-hex
ADMIN_SESSION_SECRET=your-random-32-byte-hex-session-signing-secret

# --- Legacy/Programmatic Bearer Token Route Guard (Used by src/proxy.js) ---
ADMIN_SECRET_KEY=your-strong-random-admin-secret-token

# --- Client Telemetry & Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# --- OAuth Authentication ---
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# --- Internal Telemetry & Play Console Metadata (Server-Only) ---
GOOGLE_PLAY_DEVELOPER_ID=your-google-play-developer-id
GOOGLE_PLAY_BUCKET_ID=your-google-play-bucket-id
